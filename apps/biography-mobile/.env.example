# Public endpoint only; never place a gateway access token or Doubao key here.
# H5 reads this directly. App builds pass it to the native plugin as gatewayURL.
VITE_BIOGRAPHY_VOICE_GATEWAY_URL=ws://127.0.0.1:8091/v1/voice/session
# Set true only when testing H5 without a microphone. It is ignored by the native plugin.
VITE_BIOGRAPHY_VOICE_DEBUG_TEXT=false
# Optional when auth/progress APIs are served from a different origin than the voice gateway.
VITE_BIOGRAPHY_AUTH_BASE_URL=http://127.0.0.1:8091
# Optional public login entry. Leave empty to use OIDC discovery + PKCE from /v1/auth/config.
VITE_BIOGRAPHY_AUTH_LOGIN_URL=
# H5 callback/deep-link target that receives oidc_token/access_token/id_token.
VITE_BIOGRAPHY_AUTH_REDIRECT_URL=
# Local development only: show a token paste box on the login page.
VITE_BIOGRAPHY_AUTH_DEV_TOKEN_INPUT=false
