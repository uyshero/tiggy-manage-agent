# Public endpoint only; never place a gateway access token or Doubao key here.
# H5 reads this directly. App builds pass it to the native plugin as gatewayURL.
VITE_BIOGRAPHY_VOICE_GATEWAY_URL=ws://127.0.0.1:8091/v1/voice/session
# Set true only when testing H5 without a microphone. It is ignored by the native plugin.
VITE_BIOGRAPHY_VOICE_DEBUG_TEXT=false
