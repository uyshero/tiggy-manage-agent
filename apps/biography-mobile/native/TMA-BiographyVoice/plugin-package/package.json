{
  "name": "TMA Biography Voice",
  "id": "TMA-BiographyVoice",
  "version": "0.3.0",
  "description": "Full-duplex native voice capture, barge-in, private recording management, playback, and secure interview recovery for the TMA biography app.",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "plugins": [
        {
          "type": "module",
          "name": "TMA-BiographyVoice",
          "class": "com.tma.biography.voice.TMABiographyVoiceModule"
        }
      ],
      "integrateType": "aar",
      "dependencies": [
        "com.squareup.okhttp3:okhttp:4.12.0",
        "androidx.security:security-crypto:1.1.0-alpha06"
      ],
      "compileOptions": {
        "sourceCompatibility": "1.8",
        "targetCompatibility": "1.8"
      },
      "minSdkVersion": "23",
      "useAndroidX": true,
      "permissions": [
        "<uses-permission android:name=\"android.permission.RECORD_AUDIO\"/>",
        "<uses-permission android:name=\"android.permission.INTERNET\"/>",
        "<uses-permission android:name=\"android.permission.MODIFY_AUDIO_SETTINGS\"/>"
      ]
    },
    "ios": {
      "plugins": [
        {
          "type": "module",
          "name": "TMA-BiographyVoice",
          "class": "TMABiographyVoiceModule"
        }
      ],
      "integrateType": "framework",
      "frameworks": [
        "AVFoundation.framework",
        "AudioToolbox.framework",
        "Security.framework"
      ],
      "embedSwift": true,
      "deploymentTarget": "13.0",
      "validArchitectures": [
        "arm64"
      ],
      "privacies": [
        "NSMicrophoneUsageDescription"
      ],
      "plists": {
        "NSMicrophoneUsageDescription": "用于记录您口述的人生故事"
      }
    }
  }
}
